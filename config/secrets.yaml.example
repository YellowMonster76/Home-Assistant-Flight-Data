# Add these to your Home Assistant secrets.yaml.
# Never commit the real file.

# OpenSky Network - https://opensky-network.org/
# Create a free account, then Account -> create an API client.
# OAuth2 client credentials. Basic auth (username/password) is NOT accepted.
opensky_client_id: your-opensky-client-id
opensky_client_secret: your-opensky-client-secret

# AeroDataBox via RapidAPI - https://rapidapi.com/aedbx-aedbx/api/aerodatabox
# Optional. Without it you still get position, altitude and a guessed airline
# from the callsign prefix; with it you also get aircraft type and route.
aerodatabox_key: your-rapidapi-key
